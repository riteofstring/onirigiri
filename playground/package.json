{
  "name": "@riteofstring/onirigiri-playground",
  "version": "0.0.0",
  "private": true,
  "description": "Interactive one- and two-dimensional demo playgrounds for the Onirigiri React window system.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "vite build --config one-dimensional/vite.config.ts && vite build --config two-dimensional/vite.config.ts",
    "dev:1d": "vite --config one-dimensional/vite.config.ts",
    "dev:2d": "vite --config two-dimensional/vite.config.ts",
    "preview:chrome": "node scripts/preview-playground.mjs",
    "test": "vitest run && node --test scripts/test-surface-lab-server.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.ts",
    "test:content": "node scripts/test-playground-content.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.4",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@10.23.0"
}
