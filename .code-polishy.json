            "cpu-diagnostics-contract",
            "cpu-capability-browser",
            "workspace-navigation-browser",
            "onirigiri-unit"
          ],
          "requiredAt": "checkpoint",
          "description": "Automatic presentation keeps DOM, graphics and video native, presenting playing video through Canvas 2D surfaces. Developers choose DOM, canvas, full or preview textures, and placeholders by pane, group, workspace and phase. liveContent retains applications and keeps visible content animated through motion and overview. Presentation preserves pixels and state and meets 60 Hz cadence and 120 Hz CPU budgets during navigation, resizing and background capture."
        }
      ]
