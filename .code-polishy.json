    {
      "name": "library-build",
      "provides": ["build"],
      "argv": ["pnpm", "build"],
      "modules": ["onirigiri"],
      "runOn": ["build"],
      "timeoutSeconds": 900
    },
    {
      "name": "playground-build",
      "provides": ["build"],
      "argv": ["pnpm", "build:playground"],
      "modules": ["playground"],
      "runOn": ["build"],
      "timeoutSeconds": 900
    }
  ],
