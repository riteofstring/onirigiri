  "modules": [
    {
      "name": "onirigiri",
      "paths": [
        "src/**",
        "bench/**",
        "fixtures/packed-consumer/**",
        "scripts/**",
        "tests/**",
        ".github/workflows/**",
        "package.json",
        "pnpm-workspace.yaml",
        "tsconfig*.json",
        "vite.config.ts",
        ".node-version"
      ]
    },
    {
      "name": "playground",
      "paths": ["playground/**"]
    }
