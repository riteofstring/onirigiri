  "checks": [
    {
      "name": "package-boundary",
      "provides": ["package-contract"],
      "argv": ["node", "scripts/check-package-boundary.mjs"],
      "modules": ["onirigiri"],
      "runOn": ["check", "gate"],
      "timeoutSeconds": 300
